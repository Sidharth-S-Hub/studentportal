# Mini Student Management System Environment Variables
PORT=3000
JWT_SECRET=student_management_portal_super_secure_jwt_secret_2026

# Database Type: 'postgres', 'mysql', or 'sqlite'
# Default: 'sqlite' for instant zero-configuration local execution,
# or 'mysql' if you have configured MySQL Server 8.0 credentials below.
DB_TYPE=sqlite

# Neon PostgreSQL connection string (required when DB_TYPE=postgres)
DATABASE_URL=

# MySQL Configuration (Used when DB_TYPE=mysql)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=student_management_db

# Email / SMTP Configuration (Optional)
# If left blank, emails are automatically logged to the in-app Dispatch Center and console.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="Student Portal Admin <admin@portal.edu>"
